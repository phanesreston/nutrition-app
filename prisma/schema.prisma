generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Sex {
  MALE
  FEMALE
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum Goal {
  LOSE
  MAINTAIN
  GAIN
}

enum Meal {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model User {
  id        String       @id @default(cuid())
  email     String       @unique
  name      String?
  createdAt DateTime     @default(now())
  profile   Profile?
  entries   DiaryEntry[]
  foods     Food[]
}

/// Everything reference values and targets depend on. All fields optional:
/// targets fall back to generic values until the profile is filled in.
model Profile {
  userId            String         @id
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthYear         Int?
  sex               Sex?
  heightCm          Decimal?       @db.Decimal(5, 1)
  weightKg          Decimal?       @db.Decimal(5, 1)
  activityLevel     ActivityLevel?
  goal              Goal?
  dietaryPreference String?
  allergies         String[]       @default([])
  /// User-defined goals. Null means "use the computed reference value".
  energyTargetKcal  Int?
  proteinTargetG    Decimal?       @db.Decimal(6, 1)
  carbsTargetG      Decimal?       @db.Decimal(6, 1)
  fatTargetG        Decimal?       @db.Decimal(6, 1)
  fibreTargetG      Decimal?       @db.Decimal(6, 1)
  updatedAt         DateTime       @updatedAt
}

/// A food composition database (e.g. USDA SR Legacy), with its licence.
model FoodSource {
  id        String @id
  name      String
  version   String
  publisher String
  license   String
  url       String
  foods     Food[]
}

model Food {
  id           String          @id @default(cuid())
  sourceId     String
  source       FoodSource      @relation(fields: [sourceId], references: [id])
  /// Identifier of the food in the source database (e.g. FDC id).
  sourceFoodId String
  name         String
  category     String?
  /// Canonical GTIN for packaged products (EAN-8 as 8 digits; UPC-A and
  /// EAN-13 as 13 digits). Not unique: a user's custom food may share a
  /// barcode with an Open Food Facts product and takes precedence for them.
  barcode      String?
  brand        String?
  imageUrl     String?
  ingredients  String?
  /// Unit the nutrient values are "per 100" of: "g", or "ml" for drinks
  /// labelled per 100 ml. Diary amounts for the food are in the same unit.
  amountUnit   String          @default("g")
  /// When the record was last fetched from its remote source (cache age).
  fetchedAt    DateTime?
  /// Set for custom foods; null for foods from a shared database.
  createdByUserId String?
  createdBy    User?           @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  description  String?
  /// The record exactly as last imported from its source (a NormalisedFood),
  /// never modified by admin edits. The other columns on this model, and its
  /// nutrients and portions, hold the EFFECTIVE values: sourceData with the
  /// admin overrides applied. Null for rows that predate this column.
  sourceData   Json?
  createdAt    DateTime        @default(now())
  /// Last time an administrator changed this food.
  editedAt     DateTime?
  overrides    FoodOverride[]
  images       FoodImage[]
  audits       FoodAudit[]
  nutrients    FoodNutrient[]
  portions     FoodPortion[]
  entries      DiaryEntry[]

  @@unique([sourceId, sourceFoodId])
  @@index([name])
  @@index([barcode])
}

/// One nutrient value per 100 g of edible portion.
/// A nutrient the source does not report has NO row — missing is never zero.
model FoodNutrient {
  foodId      String
  food        Food    @relation(fields: [foodId], references: [id], onDelete: Cascade)
  /// Key from the nutrient catalogue (src/domain/nutrients/catalog.ts).
  nutrientKey String
  amount      Decimal @db.Decimal(14, 4)
  unit        String
  /// Where the effective value comes from: "admin" (correction),
  /// "admin-estimate", "label" (declared on the pack), "reference"
  /// (reference database), "user" (entered in a custom food).
  origin      String  @default("reference")

  @@id([foodId, nutrientKey])
}

/// A household measure for a food ("1 cup, chopped" = 21 g).
model FoodPortion {
  id         String  @id @default(cuid())
  foodId     String
  food       Food    @relation(fields: [foodId], references: [id], onDelete: Cascade)
  label      String
  gramWeight Decimal @db.Decimal(10, 3)
  sortOrder  Int     @default(0)

  @@index([foodId])
}

model DiaryEntry {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Calendar day the food was eaten (no time component).
  date     DateTime @db.Date
  meal     Meal
  foodId   String
  food     Food     @relation(fields: [foodId], references: [id])
  /// How the user expressed the amount: `quantity` × `unitLabel`
  /// (unitLabel is "g" or a portion label such as "1 cup, chopped").
  quantity  Decimal  @db.Decimal(10, 3)
  unitLabel String
  /// Weight of one unit in grams (1 for "g").
  unitGrams Decimal  @db.Decimal(10, 3)
  /// Total grams eaten = quantity × unitGrams. All nutrient maths uses this.
  grams     Decimal  @db.Decimal(10, 3)
  /// Per-100 nutrient values of the food as they were when this entry was
  /// logged ({ nutrientKey: "amount" }). Totals are computed from this, so
  /// later corrections to the food do not silently change past days.
  per100g   Json?
  createdAt DateTime @default(now())

  @@index([userId, date])
}

/// An administrator's correction to one field of a food. The imported value
/// stays in Food.sourceData; this row wins over it until it is removed.
model FoodOverride {
  foodId    String
  food      Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)
  /// "name", "brand", "barcode", "category", "description", "ingredients",
  /// "amountUnit", "servingSize", "packageQuantity", "image", or
  /// "n:<nutrientKey>" for a nutrient value.
  field     String
  /// The corrected value. Null means "explicitly none / unknown".
  value     String?
  /// True when the administrator marked the value as an estimate.
  estimated Boolean  @default(false)
  updatedBy String
  updatedAt DateTime @updatedAt

  @@id([foodId, field])
}

/// An uploaded product photograph. The file lives in the upload directory
/// under `filename`; it is only ever served by id.
model FoodImage {
  id         String   @id @default(cuid())
  foodId     String
  food       Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)
  filename   String   @unique
  mimeType   String
  width      Int
  height     Int
  bytes      Int
  uploadedBy String
  createdAt  DateTime @default(now())

  @@index([foodId])
}

/// One changed field per row: who changed what, from what, to what, when.
model FoodAudit {
  id        String   @id @default(cuid())
  foodId    String
  food      Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)
  field     String
  oldValue  String?
  newValue  String?
  /// "edit", "restore" (back to the imported value), "revert" (undo of an
  /// earlier edit) or "recalculate" (past diary entries updated).
  action    String
  adminId   String
  createdAt DateTime @default(now())

  @@index([foodId, createdAt])
}
