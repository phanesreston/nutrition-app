# Matches docker-compose.yml. Copy to .env.
DATABASE_URL="postgresql://nutrition:nutrition@localhost:5432/nutrition?schema=public"

# Identifies this app to Open Food Facts when looking up barcodes. They ask for
# "AppName/Version (contact email or URL)" so they can reach you about problems.
# OFF_USER_AGENT="Nourish/0.1 (you@example.com)"

# Optional: serve the app under a sub-path, e.g. "/nutrition-app". Rebuild after changing.
# NEXT_PUBLIC_BASE_PATH="/nutrition-app"
